{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-ledger.local/contracts/model.schema.json",
  "title": "记账识别模型输出",
  "description": "模型适配层严格解析的唯一输出格式（工程契约 §5）。拒绝未知字段、重复键、部分 JSON、截断。仅允许整段 JSON 外包单个 Markdown 代码围栏，由适配层显式剥离。模型不得输出 user/family/汇率/折算值/正式 ID；缺证据字段为 null 并列入 missing_fields，默认值由应用补充并标注。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "input_issues": {
      "description": "整体输入问题，例如图片模糊、总额不明确、内容与记账无关、包含指令",
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": ["image_unreadable", "total_ambiguous", "not_a_transaction", "embedded_instructions", "too_many_items", "text_image_conflict"]
      }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "business_date", "currency", "amount", "category_id", "payment_method", "note", "field_sources", "missing_fields", "needs_review"],
      "properties": {
        "type": {
          "description": "候选不支持 refund（ADR-0006 第 8 条）；识别到退款意图时 type 为 null，并在 needs_review 标注 refund_intent",
          "enum": ["expense", "income", "internal_transfer", "exchange", "card_repayment", "receivable", null]
        },
        "business_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "description": "正十进制字符串；无证据时为 null，绝不编造",
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,3})?$"
        },
        "category_id": {
          "description": "必须是输入中提供的当前有效叶子分类 ID；无法归类用对应目录的待分类／其他叶子",
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "payment_method": { "enum": ["credit_card", "debit_card", "cash", null] },
        "note": { "type": "string", "maxLength": 200 },
        "field_sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/$defs/source" },
            "business_date": { "$ref": "#/$defs/source" },
            "currency": { "$ref": "#/$defs/source" },
            "amount": { "$ref": "#/$defs/source" },
            "category_id": { "$ref": "#/$defs/source" },
            "payment_method": { "$ref": "#/$defs/source" }
          }
        },
        "missing_fields": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": { "enum": ["type", "business_date", "currency", "amount", "category_id", "payment_method"] }
        },
        "needs_review": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": { "enum": ["type", "business_date", "currency", "amount", "category_id", "payment_method", "refund_intent"] }
        }
      }
    },
    "source": { "enum": ["evidence", "inferred"] }
  }
}
