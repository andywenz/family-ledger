LEDGER_TABLE=ledger-main
LEDGER_DELETION_TABLE=ledger-deletion-journal
DYNAMODB_ENDPOINT=http://localhost:8000
LEDGER_LOCAL_DATA_DIR=.local-data
LEDGER_DEFAULT_TIMEZONE=Pacific/Auckland
LEDGER_MAX_AMOUNT=1000000
LEDGER_BUDGET_NZD=15
